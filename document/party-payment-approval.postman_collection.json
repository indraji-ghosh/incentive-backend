    },
    {
      "name": "03 - Rejection and Resubmission Flow",
      "item": [
        {
          "name": "Rejection - Step 1: Reject Voucher with Mandatory Reason",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_l1_a}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Discrepancy in attached bill deduction. Please review wagon deduction.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/transaction/commission-payments/{{paymentId}}/reject",
              "host": ["{{baseUrl}}"],
              "path": ["transaction", "commission-payments", "{{paymentId}}", "reject"]
            }
          }
        },
        {
          "name": "Rejection - Step 2: Resubmit Voucher after Correction",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_submitter}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"remarks\": \"Corrected wagon weight calculation per Manager feedback.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/transaction/commission-payments/{{paymentId}}/submit",
              "host": ["{{baseUrl}}"],
              "path": ["transaction", "commission-payments", "{{paymentId}}", "submit"]
            }
          }
        }
      ]
