    {
      "name": "02 - Happy Path Approval Workflow",
      "item": [
        {
          "name": "Step 1: Create Draft Party Payment",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.test('Status is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Voucher status is DRAFT', function () {",
                  "    pm.expect(jsonData.data.status).to.eql('DRAFT');",
                  "});",
                  "if (jsonData.data && jsonData.data.commissionPaymentId) {",
                  "    pm.collectionVariables.set('paymentId', jsonData.data.commissionPaymentId);",
                  "    console.log('Saved paymentId: ' + jsonData.data.commissionPaymentId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_submitter}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"partyId\": 1,\n  \"paymentAmount\": 50000.00,\n  \"paymentDate\": \"2026-09-30\",\n  \"paymentMethod\": \"BANK_TRANSFER\",\n  \"remarks\": \"Test vendor settlement payment\",\n  \"allocations\": []\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/transaction/commission-payments",
              "host": ["{{baseUrl}}"],
              "path": ["transaction", "commission-payments"]
            }
          }
        },
        {
          "name": "Step 2: Submit Payment Voucher for Approval",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.test('Status is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Voucher status is PENDING_APPROVAL', function () {",
                  "    pm.expect(jsonData.data.status).to.eql('PENDING_APPROVAL');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_submitter}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"remarks\": \"Submitted by operations executive for processing\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/transaction/commission-payments/{{paymentId}}/submit",
              "host": ["{{baseUrl}}"],
              "path": ["transaction", "commission-payments", "{{paymentId}}", "submit"]
            }
          }
        },
        {
          "name": "Step 3: Negative Test - Submitter Cannot Self-Approve (Maker-Checker)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Expect 400 Bad Request or 403 Forbidden', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([400, 403]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_submitter}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"remarks\": \"Attempting to self-approve\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/transaction/commission-payments/{{paymentId}}/approve",
              "host": ["{{baseUrl}}"],
              "path": ["transaction", "commission-payments", "{{paymentId}}", "approve"]
            }
          }
        },
