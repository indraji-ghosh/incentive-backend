            "url": {
              "raw": "{{baseUrl}}/transaction/commission-payments/{{paymentId}}/pay",
              "host": ["{{baseUrl}}"],
              "path": ["transaction", "commission-payments", "{{paymentId}}", "pay"]
            }
          }
        },
        {
          "name": "Step 10: Fetch Voucher & Approval Audit Details",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.test('Status is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Audit history contains all sequential actions', function () {",
                  "    pm.expect(jsonData.data.history.length).to.be.above(0);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_submitter}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/transaction/commission-payments/{{paymentId}}/approval",
              "host": ["{{baseUrl}}"],
              "path": ["transaction", "commission-payments", "{{paymentId}}", "approval"]
            }
